# === Portfolio HTML Upload (admin feature) ===

# Vercel Blob storage token. Auto-injected when you link the project to a
# Vercel Blob store via `vercel link` + `vercel env pull`. For local dev,
# create a development store at https://vercel.com/<team>/<project>/stores
# and pull it into .env.local.
BLOB_READ_WRITE_TOKEN=

# Admin upload token (base64). Generate locally with:
#   openssl rand -base64 32
# Set the same value in Vercel Project Settings -> Environment Variables.
# Used by /api/admin/projects/upload to gate POST requests via the
# `Authorization: Bearer <value>` header.
ADMIN_UPLOAD_KEY_B64=
